modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["node", "dist/index.js"]
build = ["pnpm", "run", "build"]

[userenv]

[userenv.shared]
VITE_APP_ID = "placeholder-app-id"
VITE_OAUTH_PORTAL_URL = "https://createdesignpublish.net"
OAUTH_SERVER_URL = "https://createdesignpublish.net"
JWT_SECRET = "dev-secret-key-please-change-in-production"
